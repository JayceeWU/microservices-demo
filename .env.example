# Optional overrides (compose.yaml falls back to the defaults shown if unset)
# AUTH_MODE=oidc
# POSTGRES_PORT=5432
# PAYMENT_MODE=fake   # local demo only; no actual charge
# ENABLE_SIMULATED_PAYMENTS=true  # enabled by local Compose; disable when PAYMENT_MODE=stripe
# Stripe mode requires both STRIPE_* values and ENABLE_SIMULATED_PAYMENTS=false

POSTGRES_PASSWORD=dancehub-dev
DATABASE_MIGRATOR_PASSWORD=dancehub-migrator-dev
ACCOUNT_DB_PASSWORD=dancehub-account-dev
CATALOG_DB_PASSWORD=dancehub-catalog-dev
SCHEDULING_DB_PASSWORD=dancehub-scheduling-dev
CREDIT_DB_PASSWORD=dancehub-credit-dev
ORDERS_DB_PASSWORD=dancehub-orders-dev
PAYMENT_DB_PASSWORD=dancehub-payment-dev
PAYROLL_DB_PASSWORD=dancehub-payroll-dev
RECOMMENDATION_DB_PASSWORD=dancehub-recommendation-dev
OUTBOX_DB_PASSWORD=dancehub-outbox-dev
PROJECTION_DB_PASSWORD=dancehub-projection-dev
KEYCLOAK_DB_PASSWORD=dancehub-keycloak-dev
CHAT_DB_PASSWORD=dancehub-chat-dev
CHAT_RELAY_DB_PASSWORD=dancehub-chat-relay-dev
CHAT_MEDIA_DB_PASSWORD=dancehub-chat-media-dev
RABBITMQ_USER=dancehub
RABBITMQ_PASSWORD=dancehub-dev
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev
AUTH_SECRET=replace-with-at-least-32-random-characters
# Must match the student-web client secret in infra/keycloak/realm.local.json
AUTH_KEYCLOAK_SECRET=student-web-local-secret
MINIO_ROOT_USER=dancehub
MINIO_ROOT_PASSWORD=dancehub-dev-password
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
